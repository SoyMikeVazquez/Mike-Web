.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Claves, certificados y credenciales
*.pem
*.key
*.cert
*.crt
id_rsa
id_dsa
*.pfx
*.p12

# Archivos comprimidos de respaldo / despliegue
*.zip
*.tar.gz
*.rar
*.7z

